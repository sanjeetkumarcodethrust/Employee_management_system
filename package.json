{
  "name": "employee-management-system-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "EMPLOYEE_MANAGEMENT_SYSTEM",
    "backend"
  ],
  "scripts": {
    "dev": "node dev.js",
    "dev:frontend": "cd EMPLOYEE_MANAGEMENT_SYSTEM && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build:frontend": "cd EMPLOYEE_MANAGEMENT_SYSTEM && npm run build",
    "lint:frontend": "cd EMPLOYEE_MANAGEMENT_SYSTEM && npm run lint",
    "start:backend": "cd backend && npm start"
  }
}
